FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts
COPY frontend/ ./
ARG NEXT_PUBLIC_API_URL=http://api:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_CLOUD_MODE=true
# Next also transpiles next.config.ts at start, so retain its compiler while
# pruning the remaining development dependencies.
# Bound only the compiler heap; the runtime keeps its own Node defaults.
ARG BUILD_NODE_OPTIONS=--max-old-space-size=1024
RUN NODE_OPTIONS="$BUILD_NODE_OPTIONS" npm run build \
    && mkdir -p /opt/next-config \
    && cp -a node_modules/typescript /opt/next-config/ \
    && npm prune --legacy-peer-deps --omit=dev --ignore-scripts

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_CLOUD_MODE=true
WORKDIR /app
RUN groupadd --gid 10001 cloud \
    && useradd --uid 10001 --gid cloud --no-create-home --shell /usr/sbin/nologin cloud
COPY --from=build --chown=cloud:cloud /app/.next ./.next
COPY --from=build --chown=cloud:cloud /app/public ./public
COPY --from=build --chown=cloud:cloud /app/node_modules ./node_modules
COPY --from=build --chown=cloud:cloud /opt/next-config/typescript ./node_modules/typescript
COPY --from=build --chown=cloud:cloud /app/package.json ./package.json
COPY --from=build --chown=cloud:cloud /app/next.config.ts ./next.config.ts
USER 10001:10001
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
