# Copy to .env.cloud (chmod 600). Never commit the resulting file.
# Required: generate with `openssl rand -hex 32` (hex avoids URL escaping issues).
CLOUD_DB_PASSWORD=
CLOUD_HTTP_PORT=8080
SUXIAOYOU_CLOUD_ALLOWED_ORIGIN=http://localhost:8080
SUXIAOYOU_CLOUD_ENVIRONMENT=development
SUXIAOYOU_CLOUD_COOKIE_SECURE=false
# Real operation keeps mock disabled. No model route is seeded.
SUXIAOYOU_CLOUD_ALLOW_MOCK_PROVIDER=false
SUXIAOYOU_CLOUD_DEFAULT_TOKEN_LIMIT=1000000
SUXIAOYOU_CLOUD_MAX_UPLOAD_BYTES=52428800
# A dedicated rootless Docker daemon owns isolated user engines and render jobs.
# The path and group below refer to the Linux deployment host.
CLOUD_DOCKER_SOCKET=/var/run/docker.sock
CLOUD_DOCKER_GID=0
# Optional nginx bind source on the Docker daemon host.
CLOUD_NGINX_CONFIG=./deploy/cloud/nginx.conf
# Remote/VM daemon example after copying nginx.conf to that host:
# CLOUD_NGINX_CONFIG=/srv/suxiaoyou/deploy/cloud/nginx.conf
SUXIAOYOU_CLOUD_STORAGE_BACKEND=local
# Optional environment fallback. Prefer entering API Key in the admin UI.
SUXIAOYOU_MODEL_DEEPSEEK_KEY=
# Optional additional real provider key.
SUXIAOYOU_MODEL_TEAM_KEY=
# Optional S3-compatible private object storage (separate verification required).
SUXIAOYOU_CLOUD_S3_BUCKET=
SUXIAOYOU_CLOUD_S3_ENDPOINT_URL=
SUXIAOYOU_CLOUD_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
